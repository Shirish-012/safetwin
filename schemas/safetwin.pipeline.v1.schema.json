{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safetwin:schemas:pipeline:v1",
  "$defs": {
    "Metadata": {
      "additionalProperties": false,
      "description": "Name and description of the pipeline.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "One step of the pipeline.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "operator": {
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+(@[0-9]+)?$",
          "title": "Operator",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "socket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Socket"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "id",
        "operator"
      ],
      "title": "Node",
      "type": "object"
    },
    "Spec": {
      "additionalProperties": false,
      "description": "What the pipeline does: the sockets it names and its steps.",
      "properties": {
        "sockets": {
          "additionalProperties": {
            "pattern": "^socket://\\S+$",
            "type": "string"
          },
          "title": "Sockets",
          "type": "object"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "Spec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A pipeline file.",
  "properties": {
    "apiVersion": {
      "const": "safetwin/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "Pipeline",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Pipeline",
  "type": "object"
}
